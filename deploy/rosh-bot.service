[Unit]
Description=Rosh homework bot (Bale)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rosh
WorkingDirectory=/opt/rosh_bot
ExecStart=/opt/rosh_bot/venv/bin/python -m app.main
Restart=always
RestartSec=5
# امنیت پایه
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
